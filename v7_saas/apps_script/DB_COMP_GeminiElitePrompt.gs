/**
 * Build COMPLETE elite prompt with ALL competitor data
 * v11.0: TOKEN-EFFICIENT with Oracle data priority
 * Uses FT_PrepareGeminiSummary for ~50% token reduction
 */
function buildCompleteElitePrompt(competitorData, yourDomain, projectContext) {
  // Ensure we have data
  const competitorsArray = Array.isArray(competitorData) 
    ? competitorData 
    : Object.values(competitorData || {});
    
  if (competitorsArray.length === 0) {
    Logger.log('⚠️ No competitors for elite prompt');
    return null;
  }
  
  Logger.log(`📊 Building ELITE v11.0 prompt for ${competitorsArray.length} competitors (TOKEN-EFFICIENT)`);
  
  // ═══════════════════════════════════════════════════════════════════════
  // TOKEN OPTIMIZATION: Use compressed summary if available
  // ═══════════════════════════════════════════════════════════════════════
  let tokenOptimized = false;
  let compressedData = null;
  
  if (typeof FT_OrganizeDataForTabs === 'function' && typeof FT_PrepareGeminiSummary === 'function') {
    Logger.log('   🚀 Using token-efficient data compression...');
    const organizedData = FT_OrganizeDataForTabs(competitorsArray);
    compressedData = FT_PrepareGeminiSummary(organizedData);
    tokenOptimized = true;
    Logger.log(`   ✅ Token usage: ~${compressedData.tokenEstimate} (${compressedData.compressionRatio} compression)`);
  }
  
  // ═══════════════════════════════════════════════════════════════════════
  // BUILD COMPETITOR DATA (Compressed or Full based on availability)
  // ═══════════════════════════════════════════════════════════════════════
  const fullCompetitorData = competitorsArray.map(comp => {
    // Check for Oracle data first (v11.0)
    const hasOracle = !!(comp.stages?.oracleFetcher?.success);
    const oracleData = comp.stages?.oracleFetcher?.data || {};
    
    const pageRank = comp.apiData?.openPageRank?.page_rank_decimal || 
                    comp.stages?.openPageRank?.data?.page_rank_decimal || 0;
    const domainRank = parseInt(comp.apiData?.openPageRank?.rank || 
                                comp.stages?.openPageRank?.data?.rank || 0);
    const serpResults = comp.apiData?.serper?.organic || 
                        comp.stages?.serper?.data?.organic || [];
    
    // Extract PAA questions and related searches
    const peopleAlsoAsk = comp.synthesized?.seo?.peopleAlsoAsk || 
                          comp.apiData?.serper?.peopleAlsoAsk ||
                          comp.stages?.serper?.data?.peopleAlsoAsk || [];
    const relatedSearches = comp.synthesized?.seo?.relatedSearches || 
                            comp.apiData?.serper?.relatedSearches ||
                            comp.stages?.serper?.data?.relatedSearches || [];
    
    const data = {
      domain: comp.domain || comp.url || 'unknown',
      
      // DATA SOURCE (v11.0)
      dataSource: hasOracle ? 'Oracle' : serpResults.length > 0 ? 'SERP' : 'Estimated',
      
      // COMPRESSED SIGNALS (Token-efficient v11.0)
      metrics: {
        pageRank: pageRank,
        globalRank: domainRank,
        performance: comp.apiData?.pageSpeed?.scores?.performance || 
                     comp.stages?.pageSpeed?.data?.scores?.performance || 0,
        seoScore: comp.apiData?.pageSpeed?.scores?.seo || 
                  comp.stages?.pageSpeed?.data?.scores?.seo || 0,
        contentDepth: (comp.synthesized?.website?.wordCount || oracleData.wordCount || 0) > 1500 ? 'HIGH' : 'LOW',
        schemaPresent: (comp.synthesized?.website?.schemaTypes || []).length > 0
      },
      
      // STRATEGIC SIGNALS (Not raw content - saves tokens)
      strategicSignals: {
        title: comp.synthesized?.website?.title || oracleData.title || serpResults[0]?.title || 'N/A',
        positioning: _detectPositioning(comp.synthesized?.website?.description || ''),
        topKeywords: relatedSearches.slice(0, 5).map(r => r.query || r),
        paaCount: peopleAlsoAsk.length,
        serpCount: serpResults.length
      },
      
      // KEYWORD SIGNALS (Top 5 only for token efficiency)
      keywordSignals: {
        peopleAlsoAsk: peopleAlsoAsk.slice(0, 5).map(q => q.question || q),
        relatedSearches: relatedSearches.slice(0, 5).map(r => r.query || r)
      }
    };
    
    Logger.log(`   [${data.domain}]: Source=${data.dataSource}, PR=${pageRank}, SERP=${serpResults.length}`);
    return data;
  });
  
  const competitorDomains = fullCompetitorData.map(c => c.domain);
  
  // Build the user prompt with ESTIMATION TASK FIRST
  return buildEliteUserPromptV8_(fullCompetitorData, yourDomain, projectContext, competitorDomains);
}

/**
 * Detect positioning from description (helper for token efficiency)
 */
function _detectPositioning(desc) {
  const d = (desc || '').toLowerCase();
  if (d.includes('enterprise') || d.includes('professional')) return 'Enterprise';
  if (d.includes('best') || d.includes('top')) return 'Leader';
  if (d.includes('free') || d.includes('easy')) return 'Accessible';
  if (d.includes('trusted') || d.includes('expert')) return 'Authority';
  return 'General';
}

